# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codesage

# Google Gemini (get a free key from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=768

# Toggle AI features (auto-disabled if GEMINI_API_KEY is empty)
AI_ENABLED=true

# Code execution — Piston public API (no key needed)
PISTON_URL=https://emkc.org/api/v2/piston

# RAG vector backend: "memory" (in-memory cosine, zero infra). PostgreSQL/pgvector remains the intended persistent backend.
VECTOR_BACKEND=memory
VECTOR_INDEX=vector_index
